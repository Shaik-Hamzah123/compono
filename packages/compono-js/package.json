{
  "name": "@skhamzah123/compono-js",
  "version": "0.1.0",
  "description": "Agent-oriented, code-based PPTX generation for TypeScript/JS — typed primitives, no raw coordinates, rendered via pptxgenjs.",
  "type": "module",
  "license": "MIT",
  "author": "Shaik-Hamzah123 <hamzah.shaik2003@gmail.com>",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "compono-js": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "commander": "^12.1.0",
    "docx": "^9.7.1",
    "fontkit": "^2.0.4",
    "image-size": "^2.0.2",
    "pptxgenjs": "^3.12.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "jszip": "^3.10.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
